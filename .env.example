# Required. Must be https; without both of these the app answers 503 instead of serving the board.
SUPABASE_URL=https://your-project.supabase.co
# Server-only key: set directly in Vercel, never in NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=your-supabase-secret-key-or-service-role-key
# Optional: whose progress visitors see by default before signing in. Trimmed and lowercased,
# and must be 2-24 letters, numbers or underscores. Defaults to brother.
CHECKPOINT_USERNAME=brother
# Optional: the display name shown before any profile exists. Defaults to My brother.
CHECKPOINT_DISPLAY_NAME=My brother
